# Copy to .env and fill in your Aliyun OSS credentials.
# cp .env.example .env

# OSS bucket name (without oss:// prefix)
OSS_BUCKET=your-bucket-name

# Bucket endpoint, e.g. https://oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# Region ID (optional if endpoint is oss-<region>.aliyuncs.com), e.g. cn-beijing
OSS_REGION=cn-beijing

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Jekyll site URL used in sitemap, canonical links, etc.
SITE_URL=https://shadowstitch.cn

# Optional: printed after a successful deploy
OSS_WEBSITE_URL=https://shadowstitch.cn
